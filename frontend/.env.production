# 【生产】环境变量 - 覆盖通用配置

# 环境标识
VITE_APP_ENV = production

# 项目名称
VITE_APP_TITLE = FastapiAdmin

# API 请求基础路径（通过同源 Nginx 代理到后端）
VITE_API_URL = /api/v1
VITE_API_BASE_URL = https://admin.gmlhub.top

# 是否删除控制台输出
VITE_DROP_CONSOLE = true

# WebSocket 端点（AI对话功能需要配置，生产环境建议使用 wss）
VITE_APP_WS_ENDPOINT = wss://admin.gmlhub.top
