{
  "name": "fastcore",
  "description": "FastCore 管理控制台",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "i": "corepack pnpm install",
    "dev": "vite",
    "dev:force": "vite --force",
    "prod": "vite --mode prod",
    "build": "vue-tsc --noEmit && vite build",
    "build:pro": "vite build --mode pro",
    "build:gitee": "vite build --mode gitee",
    "build:dev": "vite build --mode dev",
    "build:test": "vite build --mode test",
    "serve:pro": "vite preview --mode pro",
    "serve:dev": "vite preview --mode dev",
    "serve:test": "vite preview --mode test",
    "clean": "pnpx rimraf node_modules",
    "ts:check": "vue-tsc --noEmit --skipLibCheck",
    "npm:check": "pnpx npm-check-updates -u",
    "clean:cache": "pnpx rimraf node_modules/.cache node_modules/.vite",
    "prepare": "cd .. && husky frontend/.husky",
    "icon": "esno ./scripts/icon.ts",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/site-e2e.cjs",
    "test:e2e:table-menu": "node tests/table-menu-e2e.cjs",
    "test:e2e:retry": "SITE_E2E_INTERACTIONS_ONLY=1 node tests/site-e2e.cjs",
    "test:e2e:preflight": "node tests/ux-e2e.cjs --preflight",
    "test:hooks": "node --test tests/git-hooks.test.cjs",
    "test:watch": "vitest",
    "lint": "corepack pnpm run lint:eslint && corepack pnpm run lint:prettier && corepack pnpm run lint:stylelint",
    "lint:check": "corepack pnpm run lint:eslint:check && corepack pnpm run lint:prettier:check && corepack pnpm run lint:stylelint:check",
    "lint:eslint:check": "eslint \"src/**/*.{vue,ts,js}\"",
    "lint:prettier:check": "prettier --check \"**/*.{js,cjs,ts,json,tsx,css,less,scss,vue,html,md}\"",
    "lint:stylelint:check": "stylelint \"**/*.{css,scss,vue}\"",
    "lint:eslint": "eslint --cache \"src/**/*.{vue,ts,js}\" --fix",
    "lint:prettier": "prettier --write \"**/*.{js,cjs,ts,json,tsx,css,less,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint \"**/*.{css,scss,vue}\" --cache --fix",
    "lint:lint-staged": "lint-staged --config ./package.json",
    "commit": "git-cz",
    "check": "node scripts/check.cjs",
    "test:tooling": "node --test tests/git-hooks.test.cjs tests/acceptance-artifacts.test.cjs tests/menu-submit.test.cjs tests/module-boundaries.test.cjs"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.{js,ts,mjs,mts,tsx}": [
      "eslint",
      "prettier --check"
    ],
    "*.{cjs,json,jsonc}": [
      "prettier --check"
    ],
    "*.vue": [
      "eslint",
      "stylelint --allow-empty-input",
      "prettier --check"
    ],
    "*.{html,htm}": [
      "prettier --check"
    ],
    "*.{scss,css,less}": [
      "stylelint --allow-empty-input",
      "prettier --check"
    ],
    "*.{md,mdx}": [
      "prettier --check"
    ],
    "*.{yaml,yml}": [
      "prettier --check"
    ],
    "../backend/**/*.{py,pyw}": [
      "uv run --directory ../backend --no-sync ruff check --no-fix --no-cache"
    ]
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@iconify-json/line-md": "^1.2.16",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@iconify/vue": "^5.0.3",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.17",
    "echarts": "^6.1.0",
    "element-plus": "~2.14.7",
    "exceljs": "^4.4.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2",
    "markdown-it-highlightjs": "^4.3.0",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "picocolors": "^1.1.1",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qs": "^6.16.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^11.4.14",
    "vue-json-pretty": "^2.6.0",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "@types/nprogress": "^0.2.3",
    "@types/qs": "^6.15.1",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/compiler-sfc": "^3.5.44",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "commitizen": "^4.3.2",
    "cz-git": "^1.14.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "playwright": "1.64.0",
    "postcss": "^8.5.30",
    "postcss-html": "^2.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.10",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.2",
    "stylelint-prettier": "^5.0.3",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.4",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-img-cutter": "^3.1.1",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=10.0.0",
    "pnpm": ">=12.11.2"
  },
  "author": "fastcore <948080782@qq.com>",
  "license": "MIT",
  "browserslist": [
    "Chrome >= 84",
    "Firefox >= 83",
    "Safari >= 14.1",
    "Edge >= 84",
    "not dead"
  ]
}
